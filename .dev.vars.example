# Copy to .dev.vars for local development. Generate real values for production.
#
# SESSION_SECRET signs the dashboard session cookie. Required.
SESSION_SECRET=dev-only-session-secret-change-me
#
# Optional Cloudflare Turnstile. Leave both unset to rely on the built-in
# per-IP rate limits. For local UI testing, Cloudflare's documented test keys
# are shown below; they always pass and are not protection.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
